# Copy to .env and set secrets:
#   cp .env.example .env

TZ=Asia/Shanghai

# Host ports (conflict with ./confluence if both use 8090)
CONFLUENCE_HTTP_PORT=8090
CONFLUENCE_SYNC_PORT=8091

# PostgreSQL (article: PG 13; JDBC host inside compose = pgsql)
POSTGRES_DB=confluence
POSTGRES_USER=confluence
POSTGRES_PASSWORD=change-me-strong

# Keep Server ID / license across restarts (only set true when changing JDBC etc.)
ATL_FORCE_CFG_UPDATE=false

# Public URL / reverse proxy: edit config/server.xml (see server.xml.proxy.example)

# Optional: config/server.xml.local (gitignored) for host-specific proxy
# CONFLUENCE_SERVER_XML=config/server.xml.local
