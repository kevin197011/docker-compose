# Nacos 3.2.4 standalone（Derby）
MODE=standalone
PREFER_HOST_MODE=hostname

# 3.x 三套认证独立开关。客户端 API / 管理 API / 控制台都打开。
NACOS_AUTH_SYSTEM_TYPE=nacos
NACOS_AUTH_ENABLE=true
NACOS_AUTH_ADMIN_ENABLE=true
NACOS_AUTH_CONSOLE_ENABLE=true
NACOS_AUTH_TOKEN_EXPIRE_SECONDS=18000

# token 必须是 Base64，解码后至少 32 字节
NACOS_AUTH_TOKEN=Q2FzZV9uYWNvc19zZWNyZXRfVG9rZW5fMjAyNTA3MDRfMTIzNDU2Nzg5MDEyMzQ1Ng==
NACOS_AUTH_IDENTITY_KEY=nacos_identity_20250704
NACOS_AUTH_IDENTITY_VALUE=nacos

# 控制台与 Server 合并部署，控制台端口 8080
NACOS_DEPLOYMENT_TYPE=merged
NACOS_CONSOLE_PORT=8080
NACOS_CONSOLE_UI_ENABLED=true
NACOS_CONSOLE_UI_DEFAULT=next

# JVM，沿用 3.x 镜像默认值
JVM_XMS=1g
JVM_XMX=1g
JVM_XMN=512m
